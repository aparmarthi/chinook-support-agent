# Copy to .env and fill in. Never commit .env.

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=chinook-support-agent

# --- Model provider ---
OPENAI_API_KEY=sk-...

# --- Models (see docs/BUILD_PLAN.md "Budget" — running on a $21 credit balance) ---
# Tiering is a cost control, not a preference. Develop cheap, demo mid-tier.
#
#   gpt-5.6-luna   $0.20 / $1.20 per 1M in/out   dev, seeding, judges, demo candidate
#   gpt-5.6-terra  $2.00 / $12.00                demo path, hard-set comparison
#   gpt-5.6-sol    $5.00 / $30.00                not used in this build
#
# Budget against these raw rates. Cached input is cheaper ($0.02 / $0.20) but
# cache *writes* cost more than base input ($0.25 / $2.50), so the first call
# through a new prefix is a premium, not a saving. Read the actual cache token
# fields off a trace before claiming any reduction.
#
# DEV DEFAULT — luna everywhere. Roughly $0.008/conversation.
AGENT_MODEL=openai:gpt-5.6-luna

# DEMO DAY — uncomment. Roughly $0.08/conversation at raw rates.
# AGENT_MODEL=openai:gpt-5.6-terra

# Per-specialist overrides. Only used by the supervisor variant, and only if the
# flat-vs-supervisor experiment (ADR-002) shows it wins. Default to AGENT_MODEL.
# BILLING_MODEL=openai:gpt-5.6-terra
# CATALOG_MODEL=openai:gpt-5.6-luna

# Evaluator judges — keep cheap, they run on every example of every experiment.
EVALUATOR_MODEL=openai:gpt-5.6-luna
